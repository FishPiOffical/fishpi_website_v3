VITE_API_TARGET=https://fishpi.cn

# Optional: scripts reuse this instead of calling /api/getKey (preferred).
# FP_API_KEY=
# Or write the key to .fp-cache/api-key (gitignored).
# Password login for scripts only when cache is empty/invalid:
# FP_USER=
# FP_PASS=

# 独立公测需求反馈：前端和代理同时启用，变更后重启/重建网站。
VITE_FEEDBACK_ENABLED=false
FEEDBACK_TARGET=http://127.0.0.1:5174

# 明确选择协议；设置中的接口版本可覆盖本机默认值并刷新切换。
# v1 兼容分批接入，完整清单见 docs/API_MODES.md。
VITE_API_MODE=v1
VITE_API_V1_TARGET=https://fishpi.cn
VITE_API_V3_TARGET=http://127.0.0.1:8081

# 旧版注册/找回密码使用部署公开的 GeeTest4 captchaId（不是私钥）。
# 默认沿用 fishpi.cn 的既有公开 ID；自建站点需与其 jiyan.id 一致。
# VITE_LEGACY_GEETEST_ID=

VITE_API_TARGET=https://fishpi.cn
# 浏览器直连；留空时仅供本地开发使用同源代理。变更后需要重新构建。
VITE_BROWSER_API_ORIGIN=https://fishpi.cn

# 密码登录时附带可选 deviceId。生产默认省略以兼容旧 Rhythm，开发默认携带。登录设备入口始终展示。
# VITE_LOGIN_DEVICES_ENABLED=false

# 独立公测需求反馈：前端和代理同时启用，变更后重启/重建网站。
VITE_FEEDBACK_ENABLED=false
FEEDBACK_TARGET=http://127.0.0.1:5174

[Unit]
Description=FishPi website SSR
After=network-online.target fishpi-feedback.service
Wants=network-online.target

[Service]
Type=simple
User=fishpi-web
Group=fishpi-web
WorkingDirectory=/opt/fishpi/current
Environment=NODE_ENV=production
Environment=PORT=5173
Environment=VITE_API_TARGET=https://fishpi.cn
Environment=VITE_SITE_ORIGIN=https://new.fishpi.cn
Environment=VITE_FEEDBACK_ENABLED=true
Environment=FEEDBACK_TARGET=http://127.0.0.1:5174
ExecStart=/opt/fishpi/runtime/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0027

[Install]
WantedBy=multi-user.target

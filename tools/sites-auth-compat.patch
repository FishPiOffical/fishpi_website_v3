+// 无令牌模式不能按空字符串拆分错误，Bearer 错误也不能输出凭据。
+function redactGitError(message) {
+  const text = typeof message === "string" ? message : "";
+  return (typeof credential?.token === "string" && credential.token
+    ? text.split(credential.token).join("[redacted]")
+    : text).replace(/(authorization\s*:\s*(?:bearer|basic)\s+)\S+/gi, "$1[redacted]").trim();

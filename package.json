{
  "name": "website_v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "dev:spa": "vite",
    "build": "vue-tsc -b && npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "NODE_ENV=production node server.js",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "auth:check": "node scripts/dev-auth.mjs",
    "auth:login": "node scripts/dev-auth.mjs --login"
  },
  "dependencies": {
    "@unhead/ssr": "^3.4.2",
    "@unhead/vue": "^3.4.2",
    "js-md5": "^0.9.2",
    "lottie-web": "^5.12.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-md5": "^0.8.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "sass": "^1.105.1",
    "sirv": "^3.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
